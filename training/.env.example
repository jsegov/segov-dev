# Copy to training/.env and fill in, then `source .env` before running.
# Nothing auto-loads this file; .env is gitignored.

# Tinker API key (https://tinker.thinkingmachines.ai) — required by
# `uv run python -m ama_training.train`. Export/validate/tests don't need it.
export TINKER_API_KEY=

# Neon connection string for segov-dev-ama-traces — required by
# `pnpm --filter ama-training export`.
export DATABASE_URL=
