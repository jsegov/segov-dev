# Copy this file to training/.env and fill it in, then `source .env` before running.
# Nothing auto-loads this file; .env is gitignored.

# Tinker API key (https://tinker.thinkingmachines.ai) — required by
# `uv run python -m ama_training.train`. Export/validate/tests don't need it.
export TINKER_API_KEY=

# Neon connection string for segov-dev-ama-traces — required by
# `pnpm --filter ama-training export`.
export DATABASE_URL=

# Modal proxy-auth token pair (modal.com -> Settings -> Proxy Auth Tokens) —
# required to call the deployed vLLM endpoint (deploy gates, eval runs). The
# same values go to Vercel as AMA_INFERENCE_HEADERS; see deploy/README.md.
export MODAL_PROXY_KEY=
export MODAL_PROXY_SECRET=
